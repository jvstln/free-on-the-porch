# ---------------------------------------------------------------------------
# Environment variables – copy to `.env` and fill in real values:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- App / server ---
NODE_ENV=development
PORT=3000

# --- Database (compose + drizzle client) ---
DATABASE_URL=postgresql://porch:porch@localhost:5433/porch
DATABASE_PORT=5433
DATABASE_USER=porch
DATABASE_PASSWORD=porch
DATABASE_NAME=porch

# --- Better Auth ---
# Must be at least 32 characters. Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-please-use-openssl-rand-base64-32

# Comma-separated list of allowed origins (scheme/exp origins are added automatically)
CORS_ORIGIN=http://localhost:8081

# --- File storage ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- Mail ---
# "console" (default), "mailjet", or "resend". Leave provider-specific keys blank for console.
MAIL_PROVIDER=console
MAILJET_API_KEY=
MAILJET_SECRET=
RESEND_API_KEY=

# --- Public / client ---
# Point at the host running the API.
#   iOS simulator / web:  http://localhost:3000
#   Android emulator:     http://10.0.2.2:3000
#   Physical device:      your machine's LAN IP, e.g. http://192.168.1.10:3000
PUBLIC_SERVER_URL=http://localhost:3000

# Display name used across the app and in auth/mail templates (better-auth appName).
PUBLIC_APP_NAME=free-on-the-pouch

# From-address used when sending emails (password reset, verification, etc.).
PUBLIC_EMAIL=no-reply@free-on-the-porch.app

# Deep-link scheme; must match "scheme" in apps/native/app.json.
PUBLIC_SCHEME=free-on-the-pouch
