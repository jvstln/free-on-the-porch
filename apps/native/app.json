{
	"expo": {
		"scheme": "free-on-the-pouch",
		"userInterfaceStyle": "automatic",
		"orientation": "default",
		"icon": "./assets/logo-icon.png",
		"web": {
			"bundler": "metro"
		},
		"android": {
			"package": "com.free_on_the_porch.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/logo-icon.png",
				"backgroundColor": "#faf9f4"
			},
			"permissions": [
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.CAMERA",
				"android.permission.RECORD_AUDIO"
			],
			"googleServicesFile": "./google-services.json"
		},
		"ios": {
			"bundleIdentifier": "com.free-on-the-porch.app",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			},
			"googleServicesFile": "./GoogleService-Info.plist"
		},
		"name": "free-on-the-pouch",
		"slug": "free-on-the-pouch",
		"plugins": [
			"expo-font",
			"expo-router",
			"expo-secure-store",
			"expo-web-browser",
			"react-native-nitro-google-signin",
			[
				"expo-splash-screen",
				{
					"image": "./assets/logo-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#faf9f4"
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select item images.",
					"cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take item photos."
				}
			],
			[
				"expo-location",
				{
					"locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to discover and post free items nearby.",
					"locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to discover and post free items nearby."
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "3a8172f1-548d-491c-9048-3c2105515d26"
			}
		}
	}
}
